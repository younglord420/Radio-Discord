{
  "name": "discord-radio",
  "version": "1.0.0",
  "description": "Production-ready Discord bot for live Indonesian internet radio stations",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "deploy": "tsx scripts/deploy-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "discord",
    "radio",
    "indonesia"
  ],
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "better-sqlite3": "^11.10.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "sodium-native": "^4.3.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
